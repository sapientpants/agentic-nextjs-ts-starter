{
  "name": "agentic-nextjs-ts-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workflows": "./scripts/actionlint.sh",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "lint:yaml": "yamllint '**/*.{yml,yaml}' --ignore='node_modules/**' --ignore='.github/workflows/**' --ignore='pnpm-lock.yaml'",
    "lint:spelling": "cspell lint --no-progress '**'",
    "deps:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json app/",
    "deps:graph": "madge app/ --ts-config tsconfig.json --image reports/deps-graph.png",
    "deps:summary": "madge --summary app/ --ts-config tsconfig.json",
    "deps:check": "ncu",
    "deps:update:minor": "ncu -u --target minor",
    "deps:update:patch": "ncu -u --target patch",
    "deps:update:latest": "ncu -u --target latest",
    "deps:cruise": "depcruise app --config .dependency-cruiser.js",
    "deps:cruise:graph": "depcruise app --include-only '^app' --output-type dot | dot -T svg > dependency-graph.svg",
    "deps:unused": "depcheck",
    "license:check": "license-checker --summary",
    "license:report": "license-checker --json --out reports/licenses.json",
    "license:csv": "license-checker --csv --out reports/licenses.csv",
    "dead-code": "knip",
    "duplication": "jscpd app/",
    "duplication:tests": "jscpd tests/ --threshold 5 --output ./reports/jscpd-tests",
    "mutation-test": "stryker run",
    "mutation-test:incremental": "stryker run --incremental",
    "size": "size-limit",
    "perf:bench": "autocannon -c 100 -d 10 http://localhost:3000",
    "metrics": "pnpm deps:summary && pnpm deps:circular && pnpm duplication",
    "metrics:update": "node scripts/extract-quality-metrics.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --reporter=verbose --coverage",
    "test:coverage:watch": "vitest --coverage",
    "coverage:open": "open coverage/index.html",
    "clean": "rimraf .next coverage",
    "reset": "pnpm clean && pnpm install",
    "quick-check": "pnpm typecheck && pnpm lint && pnpm test",
    "check:static": "pnpm format && pnpm lint:spelling && pnpm lint:yaml && pnpm lint:markdown && pnpm lint:workflows && ./scripts/check-version-drift.sh && pnpm typecheck && pnpm lint",
    "check:deps": "pnpm deps:circular && pnpm deps:cruise && pnpm duplication && pnpm duplication:tests && pnpm dead-code",
    "precommit": "pnpm audit --audit-level critical && pnpm check:static && pnpm check:deps && pnpm test:coverage && pnpm changeset:status",
    "setup": "./scripts/setup.sh",
    "lint-staged": "lint-staged",
    "sbom": "pnpm dlx @cyclonedx/cdxgen -o sbom.cdx.json",
    "scan:container": "./scripts/scan-container.sh",
    "scan:container:sarif": "./scripts/scan-container.sh --format sarif --output container-scan.sarif",
    "scan:secrets": "./scripts/scan-secrets.sh",
    "scan:secrets:protect": "./scripts/scan-secrets.sh protect",
    "scan:secrets:history": "./scripts/scan-secrets.sh history",
    "scan:secrets:report": "./scripts/scan-secrets.sh report",
    "prepare": "husky",
    "release": "changeset version && pnpm build",
    "release:tag": "git add -A && git commit -m \"chore(release): version packages\" && git tag -a v$(node -p \"require('./package.json').version\") -m \"Release\"",
    "commit": "git-cz",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=main",
    "ci:local": "./scripts/ci-local.sh",
    "ci:local:fast": "./scripts/ci-local.sh --fast",
    "doctor": "node scripts/doctor.js",
    "help": "node scripts/help.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,json,jsonc,json5}": [
      "eslint --fix"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{yml,yaml}": [
      "yamllint"
    ]
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cyclonedx/cdxgen": "12.9.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@fast-check/vitest": "0.5.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@size-limit/file": "14.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autocannon": "8.0.0",
    "changelog-github-custom": "1.2.9",
    "commitizen": "4.3.2",
    "cspell": "10.4.0",
    "cz-conventional-changelog": "3.3.0",
    "depcheck": "1.4.7",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-barrel-files": "2.3.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.2",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "79.0.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "30.1.3",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "6.43.0",
    "license-checker": "25.0.1",
    "lint-staged": "17.6.0",
    "madge": "8.0.0",
    "markdownlint-cli2": "0.24.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "size-limit": "14.3.0",
    "typescript": "6.0.3",
    "validate-branch-name": "1.3.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml-lint": "1.7.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
