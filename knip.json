{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "tests/**/*.spec.{ts,tsx}"],
  "project": ["app/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
  "ignore": ["tests/**/*.template.ts"],
  "ignoreDependencies": [
    "@commitlint/cli",
    "@fast-check/vitest",
    "validate-branch-name",
    "fast-check",
    "eslint-config-next"
  ],
  "ignoreBinaries": ["dot"],
  "ignoreExportsUsedInFile": true
}
